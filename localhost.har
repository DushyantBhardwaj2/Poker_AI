            "text": "export const isAuthPath = (path) => {\n  if (!path) return false;\n  const cleanPath = path.split(\"?\")[0].split(\"#\")[0].replace(/\\/$/, \"\");\n  const authPatterns = [\n    \"/auth\",\n    \"login\",\n    \"signup\",\n    \"sign-in\",\n    \"sign-up\",\n    \"signin\",\n    \"signup\",\n    \"reset-password\",\n    \"verify-email\"\n  ];\n  return authPatterns.some(\n    (pattern) => cleanPath === pattern || cleanPath.startsWith(pattern + \"/\") || cleanPath.endsWith(\"/\" + pattern) || cleanPath.includes(\"/\" + pattern + \"/\") || // Catch-all for any /auth/* route\n    cleanPath.startsWith(\"/auth\")\n  );\n};\nexport const DEFAULT_AUTH_REDIRECT = \"/auth/sign-in\";\n\n//# sourceMappingURL=data:application/json;base64,"
