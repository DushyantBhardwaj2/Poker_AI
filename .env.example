# Backend configuration. Copy to .env and fill in; python-dotenv loads it on import.
# Nothing here is required to get the API running locally — see the defaults below.

# Where game state and player stats live.
# Omit this entirely and the app falls back to sqlite:///./app.db, which is enough
# for local development: db_models.py declares a dialect-portable GUID type and
# swaps JSONB for JSON on SQLite, so the schema builds on either backend.
# In production this is a Neon pooled connection string.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Base URL of the Neon Auth project that issues the JWTs this API trusts.
# Its /.well-known/jwks.json is fetched to verify signatures. Leaving it unset is
# survivable — authenticated requests return 503 with an explanatory message
# rather than crashing the process — but nothing behind auth will work.
NEON_AUTH_URL=https://api.stack-auth.com/api/v1/projects/<project-id>

# Comma-separated allowed browser origins. localhost:3000/4231 are always allowed
# in addition to whatever is listed here.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# "local" | "development" | "production"
ENVIRONMENT=local

# Bypass token verification and act as a fixed test user. Only takes effect when
# ENVIRONMENT is local or development as well, so setting it in a production
# environment does nothing. Never set both outside your own machine.
SKIP_AUTH=false
